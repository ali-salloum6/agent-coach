[Unit]
Description=Telegram AI Coach (agent-coach)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/repo/agent-coach
EnvironmentFile=/root/repo/agent-coach/.env
ExecStart=/root/repo/agent-coach/.venv/bin/python3 bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
