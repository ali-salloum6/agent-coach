TELEGRAM_BOT_TOKEN=your-telegram-bot-token
OPENROUTER_API_KEY=your-openrouter-api-key
ACTIVE_AGENT=gym_coach

# Structured memory writer (default: structured). Set to "legacy" only for emergency rollback.
# MEMORY_WRITER_MODE=structured

# Optional: separate OpenRouter key for offline scripts (export validation, seeding from Telegram JSONL).
# OPENROUTER_API_KEY_TEST=your-openrouter-test-key

# MTProto (my.telegram.org) — used by scripts/export_telegram_chat.py only
# TELEGRAM_API_ID=12345678
# TELEGRAM_API_HASH=your_api_hash
# Optional: TELEGRAM_EXPORT_BOT_USERNAME=coach_006_bot

# Optional: HTTP proxy for Telegram + OpenRouter (e.g. tinyproxy on a WireGuard peer: http://10.8.0.1:8888)
# TELEGRAM_HTTP_PROXY=http://10.8.0.1:8888
# OPENROUTER_HTTP_PROXY=http://10.8.0.1:8888  # optional override; defaults to TELEGRAM_HTTP_PROXY

# Optional: restrict bot to a single user (use username without @, or numeric user id)
# TELEGRAM_ALLOWED_USERNAME=ali0006e
# TELEGRAM_ALLOWED_USER_ID=123456789

# Local timezone for memory timestamps and message context (IANA name).
# MEMORY_TIMEZONE=Europe/Moscow

# Text-to-speech (/read) — Kokoro-82M
# TTS_VOICE=bm_george
# TTS_ENABLED=true
# TTS_AUTO_READ=false
