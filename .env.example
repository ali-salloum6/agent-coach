TELEGRAM_BOT_TOKEN=your-telegram-bot-token
OPENROUTER_API_KEY=your-openrouter-api-key
ACTIVE_AGENT=gym_coach

# Structured memory writer (default: structured). Set to "legacy" only for emergency rollback.
# MEMORY_WRITER_MODE=structured
# Voice messages are transcribed on this machine with faster-whisper (stt.py).
# VOICE_ENABLED=1
# WHISPER_MODEL=small   # large-v3-turbo: more accurate on hard audio, about three times as slow
# WHISPER_LANGUAGE=en    # auto: detect it (multilingual models only)
# WHISPER_BEAM_SIZE=1    # 5 is about twice as slow
# Memory v2 (logs, cards, story, archive; see docs/memory-v2.md). Default 1.
# MEMORY_VERSION=2
# WEEKLY_REVIEW_DAY=monday
# WEEKLY_REVIEW_TIME=12:00

# Optional: separate OpenRouter key for offline scripts (export validation, seeding from Telegram JSONL).
# OPENROUTER_API_KEY_TEST=your-openrouter-test-key

# MTProto (my.telegram.org) — used by scripts/export_telegram_chat.py only
# TELEGRAM_API_ID=12345678
# TELEGRAM_API_HASH=your_api_hash
# Optional: TELEGRAM_EXPORT_BOT_USERNAME=your_coach_bot

# Optional: HTTP proxy for Telegram + OpenRouter (e.g. tinyproxy on a WireGuard peer: http://10.8.0.1:8888)
# TELEGRAM_HTTP_PROXY=http://10.8.0.1:8888
# OPENROUTER_HTTP_PROXY=http://10.8.0.1:8888  # optional override; defaults to TELEGRAM_HTTP_PROXY

# Optional: restrict bot to a single user (use username without @, or numeric user id)
# TELEGRAM_ALLOWED_USERNAME=your_telegram_username
# TELEGRAM_ALLOWED_USER_ID=123456789

# OpenAI GPT-6 models: reasoning effort (low|medium|high|xhigh|max, default medium)
# and answer length (low|medium|high; unset = provider default, medium).
# OPENAI_REASONING_EFFORT=medium
# OPENAI_VERBOSITY=high

# Local timezone for memory timestamps and message context (IANA name).
# MEMORY_TIMEZONE=Europe/Moscow

# Text-to-speech (/read) — Kokoro-82M
# TTS_VOICE=bm_george
# TTS_ENABLED=true
# TTS_AUTO_READ=false
